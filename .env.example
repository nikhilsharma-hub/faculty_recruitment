# Copy to .env and adjust. Loaded automatically by the npm scripts / playwright.config.js.

# --- Target + credentials ---
XSS_LOGIN_URL=http://10.0.62.109:8081/faculty/login.php
XSS_INSTRUCTIONS_URL=http://10.0.62.109:8081/faculty/Instructions.php
XSS_MANAGE_URL=http://10.0.62.109:8081/faculty/application_manage.php
XSS_EMAIL=neha.1014103503@localhost.test
XSS_PASSWORD=Fresh@123

# --- Existing application under test ---
# The suite opens Manage Application, scrolls to the last editable entry, and reuses it.
# It never creates a new application.
# XSS_APP_ID=49158
# XSS_APP_URL=http://10.0.62.109:8081/faculty/facultyapply/49158
XSS_APPLICATION_DATE=2026-10-15

# --- Spec 03 scope ---
# Run only one section (substring match on its label), e.g. Referee / Biographical / Publications:
# XSS_SECTION=Referee
# Force the full 76-payload battery on EVERY field (default: a canary gates each field,
# and the battery runs only on fields that reflect the canary unescaped):
# XSS_FULL_BATTERY=1

# --- Specs 01/02 (legacy single-form + DOM/URL) ---
# Comma-separated pages that display submitted data (for stored XSS in spec 01):
XSS_REVIEW_URLS=
# Comma-separated pages to probe for DOM XSS (spec 02):
XSS_DOM_TARGETS=http://10.0.62.109:8081/faculty/Instructions.php,http://10.0.62.109:8081/faculty/index.php
